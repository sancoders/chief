// Esquema de datos de Caseras (marketplace de servicio doméstico).
// SQLite para desarrollo; para producción cambiar provider a "postgresql"
// y regenerar migraciones (ver README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite no soporta enums en Prisma, por eso los campos de rol/estado son String.
// Valores válidos en src/lib/constants.ts.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String
  role         String   @default("CLIENT") // CLIENT | WORKER | ADMIN
  createdAt    DateTime @default(now())

  workerProfile WorkerProfile?
  bookings      Booking[]      @relation("ClientBookings")
}

model WorkerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String
  zones           String // JSON array de zonas, ej: ["Palermo","Belgrano"]
  services        String // JSON array de servicios, ej: ["limpieza","planchado"]
  hourlyRate      Int // ARS por hora
  yearsExperience Int      @default(0)
  verified        Boolean  @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())

  bookings Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type      String // HORA | DIA | MENSUAL
  date      DateTime
  hours     Int      @default(4)
  zone      String
  address   String
  notes     String   @default("")
  status    String   @default("PENDIENTE") // PENDIENTE | ACEPTADA | RECHAZADA | CANCELADA | COMPLETADA
  subtotal  Int // ARS estimado del trabajo
  fee       Int // comisión de la plataforma (ARS)
  createdAt DateTime @default(now())

  review Review?
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String
  createdAt DateTime @default(now())
}
