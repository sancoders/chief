// Esquema de datos de Caseras (marketplace de servicio doméstico).
// Postgres de Supabase en desarrollo y producción (ver README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooler en modo transacción (puerto 6543): lo usa la app, apto serverless.
  url      = env("DATABASE_URL")
  // Pooler en modo sesión (puerto 5432): lo usa la CLI (db push / seed).
  directUrl = env("DIRECT_URL")
}

// Roles y estados como String (sin enums) para mantener el schema simple.
// Valores válidos en src/lib/constants.ts.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String
  role         String   @default("CLIENT") // CLIENT | WORKER | ADMIN
  createdAt    DateTime @default(now())

  // Verificación de identidad: obligatoria para AMBOS lados antes de operar.
  // SIN_DOCS | EN_REVISION | VERIFICADA | RECHAZADA
  verificationStatus String    @default("SIN_DOCS")
  verificationNote   String    @default("") // motivo de rechazo, visible para la persona
  photo              String? // foto de perfil PÚBLICA (filename en uploads/ o URL en seeds)
  dniNumber          String?
  docFront           String? // privados: solo admin o dueño vía /api/docs
  docBack            String?
  selfie             String?
  addressStreet      String? // dirección declarada: el admin valida que coincida con el DNI
  addressZone        String?
  verifiedAt         DateTime?

  workerProfile WorkerProfile?
  bookings      Booking[]      @relation("ClientBookings")
  addresses     Address[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // "Casa", "Oficina", etc.
  zone      String
  street    String // calle y número, piso/depto
  details   String   @default("") // timbre, indicaciones
  createdAt DateTime @default(now())
}

model WorkerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String
  zones           String // JSON array de zonas, ej: ["Palermo","Belgrano"]
  services        String // JSON array de servicios, ej: ["limpieza","planchado"]
  hourlyRate      Int // ARS por hora
  yearsExperience Int      @default(0)
  createdAt       DateTime @default(now())

  bookings Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type      String // HORA | DIA | MENSUAL
  date      DateTime
  hours     Int      @default(4)
  zone      String
  address   String
  notes     String   @default("")
  status    String   @default("PENDIENTE") // PENDIENTE | ACEPTADA | RECHAZADA | CANCELADA | COMPLETADA
  subtotal  Int // ARS estimado del trabajo
  fee       Int // comisión de la plataforma (ARS)
  createdAt DateTime @default(now())

  review Review?
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String
  createdAt DateTime @default(now())
}
