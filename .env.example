# Copiá este archivo a .env y completá con tu proyecto de Supabase:
# Dashboard → Connect → ORMs → Prisma te da las dos connection strings.
# Ojo: si la contraseña tiene caracteres especiales (@ # : /) hay que
# URL-encodearla; más fácil generar una solo con letras y números.

# Pooler en modo transacción (puerto 6543): lo usa la app.
DATABASE_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Pooler en modo sesión (puerto 5432): lo usan npm run db:push y db:seed.
DIRECT_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Secreto de sesiones. En producción usar uno largo y aleatorio:
# openssl rand -hex 32
AUTH_SECRET="dev-secret-cambiar-en-produccion"

# Subidas de fotos a Supabase Storage (bucket privado "uploads").
# OBLIGATORIO en Vercel (el disco es de solo lectura); sin estas variables
# las fotos van al directorio local ./uploads (modo desarrollo).
# La service key está en Supabase → Settings → API keys.
# SUPABASE_URL="https://TU_PROYECTO.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."
